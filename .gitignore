# ===== 运行数据（隐私！请勿提交）=====
# 每天的日期文件夹（含 usage.jsonl / report.md / 浏览器访问明细等个人数据）
# 同时覆盖 YYYY-MM（月度报表目录）与 YYYY-MM-DD（每日目录）
20*-*/
20*-*
# SQLite 附加库（如启用）
usage.db
usage.db-*

# ===== 构建产物 =====
build/
dist/
*.pyc
__pycache__/

# ===== 本地私有配置（含真实联系人别名，勿提交）=====
aliases.json
# 运行期生成的数据文件（应用分组 / AI 洞察模块配置，不入库）
app_groups.json
ai_custom.json

# ===== 杂项 =====
*.bak
install_err.txt
*.log
# 沙箱测试临时目录（本地残留，可删除）
.tmp_*/
.test_patch/
_runtime_tmp/
# 演示数据（make_demo_data.py 可随时重新生成）
demo_data/
# Electron 壳（npm install / electron-builder 产物，可随时重建）
electron-app/node_modules/
electron-app/dist/
# ===== 测试/覆盖率/临时 =====
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.omo/
tmp/
growth_baseline.json
root/
x/

# AgentTeams 团队状态目录（本地工作产物，不提交）
.agent-teams/
logs/

# 本地无头浏览器 CDP 验证 profile（headless Edge 临时数据目录）
/.edge_cdp*/

# ===== 本地敏感/自动化残留（勿提交）=====
# GitHub 自动化 token 明文文件与设置脚本（含 GH_TOKEN，仅本地使用）
.github-env
setup_gh_token.ps1
# 本地 CDP 前端验证脚本
.cdp_*.mjs
# learn.py 运行期个性化基线（<data_root>/baselines.json，性质同 aliases.json / growth_baseline.json）
baselines.json
# 带时间戳的配置备份（上面的 *.bak 只匹配纯 .bak 后缀）
*.bak-*
# 误把绝对路径当相对路径写入产生的目录（如 C:\tmp\...）
/C:/

# 本地 AI CLI 工具在仓库内的工作产物（会话计划/插件状态），不入库
.zcode/
.video_agent/
